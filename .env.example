# 이 파일을 .env 로 복사해 필요한 값만 수정한다. (.env 는 커밋되지 않는다)
#
# **로컬(dev) 기준값이다.** 배포 호스트에는 그대로 복사하지 않는다.

# --- 공통 ---

# MySQL
MYSQL_ROOT_PASSWORD=rootpassword
DB_NAME=jipsa
DB_USER=jipsa
DB_PASSWORD=jipsapassword

# 호스트에 노출할 포트. Beetle(13306·8080·5173)과 동시에 띄울 수 있도록 비켜 둔다.
# 컨테이너 안쪽 포트는 그대로(3306·8080·80)이므로 컨테이너끼리는 영향을 받지 않는다.
DB_PORT=13307
BACKEND_PORT=8081
FRONTEND_PORT=5174

# --- 로컬(dev) ---

# 백엔드 스프링 프로필. 지정하지 않으면 dev 로 뜬다.
SPRING_PROFILES_ACTIVE=dev

# 프론트엔드 빌드 모드. 로컬 이미지는 소스맵을 포함하는 development 가 기본이다.
FRONTEND_BUILD_MODE=development

# --- 배포(prod) ---
#
#   docker compose -f docker-compose.yml -f docker-compose.prod.yml up -d --build
#
# 이때 위의 DB_NAME / DB_USER / DB_PASSWORD / MYSQL_ROOT_PASSWORD 는 **필수**이며,
# 값이 없으면 컨테이너가 기동에 실패한다. 기본 비밀번호로 배포되는 것보다 낫다.
# FRONTEND_PORT 는 배포 파일에서 기본 80 을 쓴다.
#
# DB 커넥션 풀 크기 (기본 20)
# DB_POOL_SIZE=20
